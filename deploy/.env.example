# Copy to deploy/.env and change both passwords before starting anything.
#   cp .env.example .env
#
# Compose refuses to start if POSTGRES_PASSWORD or AETHRA_ADMIN_PASSWORD are
# missing. That is on purpose: an unset password used to fall back to "changeme",
# which is how self-hosted boxes end up owned by a scanner.

# Postgres. Only reachable inside the compose network unless you publish the port.
POSTGRES_PASSWORD=

# First admin account, seeded on the very first boot.
AETHRA_ADMIN_EMAIL=admin@aethra.local
AETHRA_ADMIN_PASSWORD=

# URL your BROWSER uses to reach the API. Baked into the frontend at build time,
# so if you change it you must rebuild: docker compose up -d --build web.
# Behind a domain or a tunnel, set it to the public URL (https://aethra.example.com).
AETHRA_PUBLIC_API_URL=http://localhost:5080

# Published ports on the host.
AETHRA_API_PORT=5080
AETHRA_WEB_PORT=3000
AETHRA_REGISTRY_PORT=5001

# Development gives you detailed errors and a looser CORS posture. Leave it at
# Production for anything reachable from outside your machine.
ASPNETCORE_ENVIRONMENT=Production
