# Copy to deploy/.env and change both passwords before starting anything.
#   cp .env.example .env
#
# Compose refuses to start if POSTGRES_PASSWORD or AETHRA_ADMIN_PASSWORD are
# missing. That is on purpose: an unset password used to fall back to "changeme",
# which is how self-hosted boxes end up owned by a scanner.

# Postgres. Only reachable inside the compose network unless you publish the port.
POSTGRES_PASSWORD=

# First admin account, seeded on the very first boot.
AETHRA_ADMIN_EMAIL=admin@aethra.local
AETHRA_ADMIN_PASSWORD=

# Contact address registered with Let's Encrypt when Aethra issues certificates.
# The API refuses to start if this ends up empty — it is validated at startup.
AETHRA_TLS_EMAIL=admin@aethra.local

# Keep this true until you actually want trusted certificates. Let's Encrypt's
# production endpoint rate-limits hard, and staging certs are free to get wrong.
AETHRA_TLS_STAGING=true

# URL your BROWSER uses to reach the API. Baked into the frontend at build time,
# so if you change it you must rebuild: docker compose up -d --build web.
# Behind a domain or a tunnel, set it to the public URL (https://aethra.example.com).
AETHRA_PUBLIC_API_URL=http://localhost:5080

# URL your BROWSER uses to reach the web UI. Wired into the API CORS policy
# (Cors:AllowedOrigins) so remote LAN or public HTTPS browsers can make authenticated
# API requests with credentials.
# In split-origin deployments (UI on :3000, API on :5080, or separate domains), set this to
# the UI origin (e.g. http://192.168.1.50:3000 or https://aethra.example.com).
# In same-origin deployments (reverse proxy fronting both UI and /api), set both
# AETHRA_PUBLIC_API_URL and AETHRA_PUBLIC_WEB_URL to that single public origin.
AETHRA_PUBLIC_WEB_URL=http://localhost:3000

# Published ports on the host.
AETHRA_API_PORT=5080
AETHRA_WEB_PORT=3000
AETHRA_REGISTRY_PORT=5001

# Development gives you detailed errors and a looser CORS posture. Leave it at
# Production for anything reachable from outside your machine.
ASPNETCORE_ENVIRONMENT=Production
