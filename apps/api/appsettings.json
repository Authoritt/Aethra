{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/aethra-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "Aethra": "Host=localhost;Port=5432;Database=aethra;Username=aethra;Password=changeme;Include Error Detail=true"
  },
  "Identity": {
    "AdminEmail": "admin@aethra.local",
    "AdminPasswordSeed": null
  },
  "Outbox": {
    "BatchSize": 50,
    "PollIntervalMs": 2000
  },
  "AllowedHosts": "*"
}
